---
const status = ['MIDI CONTROL', 'SYNTH UTILITIES', 'DJ HARDWARE', 'OPEN SOURCE', 'MADE FOR MUSIC'];
const binaryLines = ['01001111  01000010  01010011', '01001001  01000100  01001001', '01000001  01001110  00101110'];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__main">
    <p class="eyebrow">MUSIC TECHNOLOGY / INDEPENDENT UTILITIES</p>
    <h1 class="hero__title" id="hero-title">OBSIDIAN<br /><span>MUSIC TECHNOLOGY</span></h1>
    <p class="hero__lead">Focused utilities for the instruments you already make music with.</p>
    <a class="hero__link" href="#tools">Explore the tools <span aria-hidden="true">↓</span></a>
  </div>
  <aside class="hero__side">
    <div class="hero__side-top"><p>Editors, connection tools and practical experiments for MIDI controllers, synthesizers and DJ gear.</p></div>
    <div class="hero__side-bottom">
      <h2>System Status</h2>
      <ol class="status-list">{status.map((item, i) => <li>{String(i + 1).padStart(2, '0')}. {item}</li>)}</ol>
      <pre class="binary">{binaryLines.join('\n')}</pre>
    </div>
  </aside>
</section>

