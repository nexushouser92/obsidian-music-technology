---
// EDITA: línea de apoyo, descripción lateral y los
// ítems de "System Status".
const lead = 'Tu propuesta de valor en una línea, partida en varias para dar ritmo.';
const sideCopy = 'Un párrafo breve que explique a quién sirves y qué resuelves.';

const status = [
  'MODULE A', 'MODULE B', 'MODULE C', 'MODULE D', 'MODULE E',
  'MODULE F', 'MODULE G', 'MODULE H', 'MODULE I', 'MODULE J',
];

// Decoración binaria (solo estética)
const rnd = (n) => Array.from({ length: n }, () => (Math.random() > 0.5 ? '1' : '0')).join('');
const binaryLines = Array.from({ length: 4 }, () => `${rnd(8)}  ${rnd(8)}  ${rnd(8)}`);
---

<section class="hero" id="top">
  <div class="hero__main">
    <p class="hero__lead">{lead}</p>
  </div>

  <aside class="hero__side">
    <div class="hero__side-top">
      <p>{sideCopy}</p>
    </div>

    <div class="hero__side-bottom">
      <h2>System Status</h2>
      <ol class="status-list">
        {status.map((item, i) => (
          <li>{String(i + 1).padStart(2, '0')}. {item}</li>
        ))}
      </ol>
      <pre class="binary">{binaryLines.join('\n')}</pre>
    </div>
  </aside>
</section>
