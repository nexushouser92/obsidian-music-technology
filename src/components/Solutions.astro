---
import { tools } from '../data/tools.js';
import { posts } from '../data/posts.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
---

<section class="tools reveal" id="tools">
  <div class="tools-grid">
    {tools.map((tool) => {
      const toolUrl = `${base}/tools/${tool.slug}`;
      return (
        <a class="tool-card" href={toolUrl}>
          <p class="tool-card__kind">{tool.kind}</p>
          <h3>{tool.name}</h3>
          <p class="tool-card__desc">{tool.description}</p>
        </a>
      );
    })}
  </div>
</section>

<section class="blog reveal" id="blog" aria-labelledby="blog-title">
  <header class="blog__header">
    <h2 id="blog-title" class="blog__heading">BLOG &amp; NOTICIAS</h2>
  </header>

  <div class="blog__grid">
    {posts.map((post) => {
      const postUrl = `${base}/blog/${post.slug}`;
      return (
        <a class="post-card" href={postUrl}>
          <div class="post-card__meta">
            <span class="post-card__cat">{post.category}</span>
            <time class="post-card__date" datetime={post.date}>{post.dateFormatted}</time>
          </div>
          <h3 class="post-card__title">{post.title}</h3>
          <p class="post-card__excerpt">{post.excerpt}</p>
          <span class="post-card__cta">Leer →</span>
        </a>
      );
    })}
  </div>
</section>
