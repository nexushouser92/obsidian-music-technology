---
// EDITA: nombre de marca y logo. El SVG es un marcador geométrico
// genérico — sustitúyelo por el tuyo.
const brand = 'BRAND';
---

<header class="site-header">
  <a class="logo" href="#top" aria-label={brand}>
    <svg viewBox="0 0 32 32" aria-hidden="true">
      <path d="M4 5 L18 5 L28 15 L28 27 L14 27 L4 17 Z" fill="currentColor" />
    </svg>
    <span>{brand}</span>
  </a>

  <button class="menu-btn" type="button" aria-label="Abrir menú">
    <span class="bars" aria-hidden="true"><span></span><span></span></span>
    MENU
  </button>
</header>
