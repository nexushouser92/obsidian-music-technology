---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import { tools } from '../../data/tools.js';

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '');
const homeUrl = `${base}/`;
const downloadUrl = `https://github.com/nexushouser92/${tool.repo}/archive/refs/heads/main.zip`;
const githubUrl = `https://github.com/nexushouser92/${tool.repo}`;
---

<Base title={`${tool.name} — OBSIDIAN`} description={tool.description}>
  <header class="tool-site-header">
    <nav class="site-nav" aria-label="Primary navigation">
      <a href={`${homeUrl}#tools`}>Tools</a>
      <a href={`${homeUrl}#blog`}>Blog</a>
      <a class="nav-github" href="https://github.com/nexushouser92" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
  </header>

  <main class="tool-page">
    <section class="tool-hero">
      <div class="tool-hero__content">
        <p class="eyebrow">{tool.kind}</p>
        <h1 class="tool-hero__title">{tool.name}</h1>
        <p class="tool-hero__lead">{tool.longDescription}</p>
      </div>
      <aside class="tool-hero__meta">
        <dl class="tool-meta-list">
          <div>
            <dt>Plataforma</dt>
            <dd>{tool.platform}</dd>
          </div>
          <div>
            <dt>Licencia</dt>
            <dd>{tool.license}</dd>
          </div>
          <div>
            <dt>Categoría</dt>
            <dd>{tool.kind}</dd>
          </div>
        </dl>
        <div class="tool-hero__actions">
          <a class="btn-download" href={downloadUrl}>↓ Descargar ZIP</a>
          <a class="btn-github" href={githubUrl} target="_blank" rel="noopener noreferrer">Ver en GitHub ↗</a>
        </div>
      </aside>
    </section>

    <section class="tool-features">
      <div class="tool-features__inner">
        <h2>Características</h2>
        <ul class="feature-list">
          {tool.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div class="tool-requirements">
        <p class="eyebrow">Requisitos</p>
        <ul>
          {tool.requirements.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </section>

    <div class="tool-back">
      <a href={`${homeUrl}#tools`}>← Volver a todas las herramientas</a>
    </div>
  </main>

  <Footer />
</Base>

<style>
  .tool-site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.1rem clamp(1.25rem, 4vw, 4rem);
    background: #14131c;
    border-bottom: 1px solid rgba(242, 240, 248, 0.1);
  }

  /* ── Hero ── */
  .tool-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 65vh;
    background: #ff6f59;
    color: #000101;
  }

  .tool-hero__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 6vw, 7rem);
  }

  .eyebrow { color: #fff; }

  .tool-hero__title {
    margin: 0.9rem 0 1.2rem;
    font-family: 'Bayon', sans-serif;
    font-size: clamp(2.8rem, 6vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-weight: 400;
  }

  .tool-hero__lead {
    max-width: 46ch;
    margin: 0 0 2rem;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.55;
    color: rgba(0, 0, 0, 0.72);
  }

  .tool-hero__meta {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 4vw, 4rem);
    background: #3a1c71;
    color: #fff;
    border-left: 1px solid rgba(0, 0, 0, 0.12);
  }

  .tool-hero__actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .tool-meta-list {
    display: grid;
    gap: 1.2rem;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .tool-meta-list div {
    border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    padding-bottom: 1.2rem;
  }

  .tool-meta-list div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .tool-meta-list dt {
    margin: 0 0 0.25rem;
    font: 700 0.72rem / 1.25 'Bayon', sans-serif;
    letter-spacing: 0.08em;
    color: #b3dd51;
    text-transform: uppercase;
  }

  .tool-meta-list dd {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.2;
    color: #fff;
  }

  /* ── Buttons ── */
  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 1.8rem;
    background: #b3dd51;
    color: #000;
    font: 700 0.9rem / 1 'Bayon', sans-serif;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background 0.15s;
    align-self: stretch;
    justify-content: center;
  }

  .btn-download:hover {
    background: #c5eb6a;
  }

  .btn-github {
    color: rgba(255, 255, 255, 0.65);
    font: 700 0.85rem / 1 'Bayon', sans-serif;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 2px;
    transition: color 0.15s;
  }

  .btn-github:hover {
    color: #fff;
  }

  /* ── Features / Requirements ── */
  .tool-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .tool-features__inner {
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 6vw, 7rem);
    background: #d7c4ac;
    color: #14131c;
    border-right: 1px solid rgba(20, 19, 28, 0.15);
  }

  .tool-features__inner h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.6rem, 2.5vw, 2.5rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .feature-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .feature-list li {
    padding: 0.9rem 0;
    border-bottom: 1px solid rgba(20, 19, 28, 0.18);
    font-size: 1rem;
    line-height: 1.45;
    color: #333;
  }

  .feature-list li::before {
    content: '→ ';
    color: #3a1c71;
    font-weight: 700;
  }

  .tool-requirements {
    padding: clamp(3rem, 7vw, 7rem) clamp(1.25rem, 4vw, 4rem);
    background: #639e83;
    color: #fff;
  }

  .tool-requirements .eyebrow {
    color: #b3dd51;
    margin-bottom: 1.5rem;
    display: block;
  }

  .tool-requirements ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tool-requirements li {
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 1rem;
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.9);
  }

  .tool-requirements li:last-child {
    border-bottom: 0;
  }

  /* ── Back ── */
  .tool-back {
    padding: 1.75rem clamp(1.25rem, 6vw, 7rem);
    background: #14131c;
    border-top: 1px solid rgba(242, 240, 248, 0.1);
  }

  .tool-back a {
    color: #b3dd51;
    font: 700 0.85rem / 1 'Bayon', sans-serif;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .tool-back a:hover {
    color: #fff;
  }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .tool-hero {
      grid-template-columns: 1fr;
    }

    .tool-hero__meta {
      border-left: 0;
      border-top: 1px solid rgba(0, 0, 0, 0.12);
      padding: 2.5rem 1.25rem;
    }

    .tool-features {
      grid-template-columns: 1fr;
    }

    .tool-features__inner {
      border-right: 0;
      border-bottom: 1px solid rgba(20, 19, 28, 0.15);
    }
  }
</style>
